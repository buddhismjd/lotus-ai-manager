# Python virtual environments
.venv/
venv/

# Python generated files
__pycache__/
*.py[cod]
*$py.class

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Local environment and editor files
.env
.env.local
.continue/
.vscode/

# Runtime logs and generated application data
logs/
data/
knowledge/

# Build artifacts
build/
dist/
*.egg-info/

# Local backups and migration artifacts
_backup*/
backup*/
archive*/
*.bak

# Local ad-hoc test launchers
test_*.bat

# Temporary patch and delivery artifacts
apply_*.py
*.patch.txt
*.zip

# Accidental shell-output files
tatus --short

# The application knowledge package remains trackable
!backend/knowledge/
!backend/knowledge/**/*.py
!backend/knowledge/**/*.json
