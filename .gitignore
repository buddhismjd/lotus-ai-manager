# Python environment and caches
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Local environment and editor files
.env
.continue/
.vscode/

# Runtime logs
logs/

# Local runtime data
data/knowledge.json
data/dialogs.jsonl
data/*.db
data/*.db-shm
data/*.db-wal

# Generated diagnostics and reports
data/*.csv
data/*.html

# Generated and temporary files
_backup_*/
apply_*.py
*.bak

# Root-level temporary knowledge exports
knowledge/

# The application knowledge package must remain trackable
!backend/knowledge/
!backend/knowledge/**/*.py
!backend/knowledge/**/*.json

# Local test launchers
test_*.bat
